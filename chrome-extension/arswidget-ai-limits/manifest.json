{
  "manifest_version": 3,
  "name": "ArsWidget AI Limits",
  "version": "0.1.2",
  "description": "Показывает остаток лимитов Claude и Codex в ArsWidget на этом Mac.",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "http://127.0.0.1:63554/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ArsWidget AI Limits",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
